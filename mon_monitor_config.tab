drop table if exists mon_monitor_config;

create table mon_monitor_config ( 
    id                 number generated by default as identity, 
    call_type          varchar2(20) not null, 
    publication_code   varchar2(50) not null, 
    information_type   varchar2(100) not null, 
    request_frequency  varchar2(50), 
    measurement_type   varchar2(50) default 'p90_response_time' not null, 
    warning_threshold  number, 
    breach_threshold_min number, 
    threshold_unit     varchar2(10), 
    enabled            varchar2(10) default 'TRUE' not null, 
    constraint pk_monitor_config primary key (id), 
    constraint uk_monitor_config unique (call_type,publication_code,information_type,measurement_type), 
    constraint ck_monitor_config_enabled check (enabled in ('TRUE','FALSE')) 
); 